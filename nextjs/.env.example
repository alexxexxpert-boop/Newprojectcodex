# WordPress REST API base URL
WP_API_URL=https://api.example.com/wp-json/wp/v2
# Hostname only (for next.config.js image remotePatterns)
WP_API_HOSTNAME=api.example.com

# Public site URL (used for canonical URLs, sitemap, schema markup)
NEXT_PUBLIC_SITE_URL=https://example.com

# Must match automation service NEXTJS_REVALIDATE_SECRET
REVALIDATE_SECRET=change-this-to-a-random-secret
