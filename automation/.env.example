# ─── WordPress ───────────────────────────────────────────────────────────────
WP_API_URL=https://api.example.com/wp-json/wp/v2
WP_USERNAME=admin
# Generate via WordPress Admin → Users → Application Passwords
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com
# Random secret for ISR revalidation endpoint protection
NEXTJS_REVALIDATE_SECRET=change-this-to-a-random-secret

# ─── LLM провайдер ───────────────────────────────────────────────────────────
# 'anthropic' (по умолчанию) | 'openrouter'
LLM_PROVIDER=anthropic

# --- Вариант A: Anthropic напрямую ---
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Вариант B: OpenRouter (LLM_PROVIDER=openrouter) ---
# Один ключ → доступ к Claude, GPT-4o, Gemini, DeepSeek и др.
OPENROUTER_API_KEY=sk-or-...
# Любой слаг модели с openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_REFERER=https://example.com
OPENROUTER_TITLE=Kyber SEO Automation

# ─── Прочие AI APIs ──────────────────────────────────────────────────────────
# Optional — research agent. Falls back to empty research if not set.
PERPLEXITY_API_KEY=pplx-...
# Optional — image generation. Falls back to placeholder if not set.
REPLICATE_API_TOKEN=r8_...

# ─── SEO APIs ────────────────────────────────────────────────────────────────
# Optional — keyword enrichment. Falls back to seed keyword only if not set.
SEMRUSH_API_KEY=

# ─── Google Sheets ───────────────────────────────────────────────────────────
GOOGLE_SHEETS_ID=your-spreadsheet-id-from-url
GOOGLE_SERVICE_ACCOUNT_EMAIL=seo-bot@your-project.iam.gserviceaccount.com
# Paste the full private key including newlines, enclosed in quotes
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ─── Automation behaviour ────────────────────────────────────────────────────
# 'publish' | 'draft'  — set to 'draft' for review before going live
PUBLISH_STATUS=draft
# How many minutes between each Google Sheets poll
POLL_INTERVAL_MINUTES=5

# ─── Dry-run ─────────────────────────────────────────────────────────────────
# true → вся цепочка работает на моках (без реальных API/WordPress/Sheets),
# статья пишется в output/<slug>.html. Используется командой `npm run dry-run`.
DRY_RUN=false
