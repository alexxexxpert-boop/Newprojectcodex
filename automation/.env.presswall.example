# Готовый шаблон под presswall-presswall.ru — скопируй в .env и заполни секреты.
#   cp .env.presswall.example .env

# ─── WordPress (твой сайт) ───────────────────────────────────────────────────
WP_API_URL=https://presswall-presswall.ru/wp-json/wp/v2
WP_USERNAME=ТВОЙ_ЛОГИН_АДМИНА
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ─── LLM: OpenRouter (как ты просил) ─────────────────────────────────────────
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_REFERER=https://presswall-presswall.ru
OPENROUTER_TITLE=PressWall SEO

# ─── Опциональные API ────────────────────────────────────────────────────────
PERPLEXITY_API_KEY=
SEMRUSH_API_KEY=

# Генерация картинок через Fal.ai (fal.ai → Dashboard → API Keys)
FAL_AI_KEY=
FAL_AI_MODEL=fal-ai/flux/schnell
FAL_AI_IMAGE_SIZE=landscape_16_9

# ─── Google Sheets (таблица уже создана) ─────────────────────────────────────
GOOGLE_SHEETS_ID=1ppsEFknfm9LXWnxcMvEib6ohZjN1MuIlrgeuilo6pf8
GOOGLE_SERVICE_ACCOUNT_EMAIL=seo-bot@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Поведение ───────────────────────────────────────────────────────────────
# Сначала draft! Поменяешь на publish когда проверишь качество.
PUBLISH_STATUS=draft
POLL_INTERVAL_MINUTES=5

# Next.js-витрина не обязательна для публикации в WordPress
NEXT_PUBLIC_SITE_URL=https://presswall-presswall.ru
NEXTJS_REVALIDATE_SECRET=
DRY_RUN=false
